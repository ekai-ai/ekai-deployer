# local-deployment/.env — copy this to .env and fill in the placeholders.
#
# Defaults below are filled in wherever a real, working value exists and
# copying it carries no security risk (tuning parameters, non-secret IDs,
# constants shared across Ekai's own service .env.example files).

# ── Database, vector store, cache — matches ekai-postgres/erd-redis-stack/
# erd-neo4j in docker-compose.yml ───────────────────────────────────────────
DATABASE_URL=postgresql://ekai:ekai321backend@ekai-postgres:5432/ekaibackend
REDIS_HOST=erd-redis-stack
REDIS_PORT=6379
REDIS_URI=erd-redis-stack:6379
REDIS_USERNAME=default
REDIS_PASSWORD=
NEO4J_URI=bolt://erd-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ekai_dev_@

# ── Auth, encryption — freshly generated, not reused from any live
# environment (ENCRYPTION_KEY/PLATFORM__FERNET_KEY/PLATFORM__JWT_SECRET only
# need to be valid + consistent for THIS local stack; regenerate anytime with
# `python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`).
# LLM provider keys have no possible default — real, billable API keys.
ENCRYPTION_KEY=zJGjCB9F4YomVEz6wEw9YooENKF0h_Ttl4HtoHm4WfI=
DECRYPTED_EKAI_TOKEN=EKAI@8008
PLATFORM__JWT_SECRET=zJGjCB9F4YomVEz6wEw9YooENKF0h_Ttl4HtoHm4WfI=
PLATFORM__FERNET_KEY=zJGjCB9F4YomVEz6wEw9YooENKF0h_Ttl4HtoHm4WfI=

# ── Service-to-service URLs.
FRONTEND_URL=http://localhost
AI_CORE_ENDPOINT=http://ekai-erd:9002
FRONTEND__BACKEND_URL=/api/
FRONTEND__AI_CORE_URL=/api/ai_core_ms/

# AWS Dummykey prereqs
AWS_ACCESS_KEY_ID=langfuse
AWS_SECRET_ACCESS_KEY=langfuse123
AWS_REGION=us-east-1

# ── Object storage — reuses langfuse-minio (already in docker-compose.yml,
# same MinIO instance Langfuse uses) instead of real S3. minio-init already
# creates the "ekai-files" bucket on it. MINIO_* are what the app code
# actually reads when USE_MINIO=true (AWS_ACCESS_KEY_ID/SECRET below are
# NOT used for storage in that case — kept only as harmless filler since a
# few code paths read them unconditionally for non-storage AWS calls, all
# no-ops locally).
EKAI_BUCKET=ekai-files
USE_MINIO=true
MINIO_ENDPOINT_URL=http://langfuse-minio:9000
MINIO_ACCESS_KEY=langfuse
MINIO_SECRET_ACCESS_KEY=langfuse123

# ── Runtime / misc ────────────────────────────────────────────────────────────
NODE_ENV=production
PLATFORM__PORT=3000
PLATFORM__DISABLE_USER_MANAGEMENT=true

# ── ERD-specific — REDIS_HOST/PORT/AI_CORE__REDIS_DB are already set inline
# per-service in docker-compose.yml; only the remaining AI_CORE__ keys go here.
AI_CORE__BASE_PATH=/app/workspaces
AI_CORE__REDIS_BUFFER_TIME=60

# -- Licensing specifics
EKAI_LICENSING_PORTAL_URL=https://dev.licensing.ekai.ai

